---
import Base from "../layouts/Base.astro";
import EmbedFacade from "../components/EmbedFacade.astro";
import DiscordCta from "../components/DiscordCta.astro";
import { SITE, LINKS, DISCORD, SERVICES, COMPILATION, MUSIC } from "../config";

// ヒーロー:表示のたびに Worker の /api/hero-videos(チャンネルの横動画一覧)から
// クライアント側でランダムに1本選ぶ。ここでは初期表示 兼 API 失敗時の
// フォールバック(横動画と確認済みのもの)だけを埋め込む。
const heroVideos: { id: string; title: string }[] = [
  { id: COMPILATION.videoId, title: COMPILATION.title },
  ...SERVICES.flatMap((s) => s.videos.map((id) => ({ id, title: s.title }))),
];

const hero = heroVideos[0];

const spotifyUrl = LINKS.find((l) => l.label === "Spotify")?.url ?? "";
// 作品の棚(Spotify は最新リリース枠が担うので除く)
const shelf = LINKS.filter((l) => l.label !== "Spotify").map((l) => ({
  key: l.label.toLowerCase(),
  label: l.label,
  url: l.url,
}));
---

<Base>
  <section class="hero settle-hero">
    <div class="hero-embed">
      <EmbedFacade platform="youtube" embedId={hero.id} title={hero.title} />
      <p class="meta hero-meta">
        <a
          href={`https://www.youtube.com/watch?v=${hero.id}`}
          rel="noopener"
          target="_blank">{hero.title}</a
        >
      </p>
    </div>
    {/* 縦書きはサイト全体でここ一箇所だけ(§3.3) */}
    <p class="hero-vertical" aria-hidden="true">
      {SITE.verticalLine}
    </p>
    <p class="visually-hidden">{SITE.verticalLine}</p>
  </section>

  <section class="section">
    <h2 class="section-title settle">作品</h2>

    {/* 最新リリース:内容は /api/works から取得して JS で埋める */}
    <div
      class="release settle"
      id="latest-release"
      data-itunes-id={MUSIC.itunesArtistId}
    >
      <a
        class="release-cover"
        href={spotifyUrl}
        rel="me noopener"
        target="_blank"
        aria-label="最新リリースを Spotify で聴く"
      >
        <img
          class="melt-on-hover"
          alt=""
          width="600"
          height="600"
          loading="lazy"
          hidden
        />
      </a>
      <div class="release-info">
        <p class="meta">最新リリース</p>
        <h3 class="release-title"></h3>
        <p class="meta release-date"></p>
        <p class="release-listen">
          <a href={spotifyUrl} rel="me noopener" target="_blank"
            >Spotify で聴く</a
          >
        </p>
      </div>
    </div>

    <div class="compilation settle">
      <h3 class="service-title">{COMPILATION.label}</h3>
      <div class="compilation-video">
        <EmbedFacade
          platform="youtube"
          embedId={COMPILATION.videoId}
          title={COMPILATION.title}
        />
      </div>
    </div>

    {/* 棚:各プラットフォームの最新ビジュアルを /api/works から埋める */}
    <div class="shelf settle">
      {
        shelf.map((card) => (
          <a
            class="shelf-card"
            data-card={card.key}
            href={card.url}
            rel="me noopener"
            target="_blank"
          >
            <span class="shelf-thumb">
              <span class="shelf-blank" aria-hidden="true">
                {card.label}
              </span>
              <img class="melt-on-hover" alt="" loading="lazy" hidden />
            </span>
            <span class="meta shelf-label">{card.label}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2 class="section-title settle">依頼</h2>
    <p class="section-lead settle">
      相談は
      <a href={DISCORD.inviteUrl} rel="noopener" target="_blank">Discord</a>
      から。
    </p>
    <div class="services">
      {
        SERVICES.map((service) => (
          <div class="service settle">
            <h3 class="service-title">{service.title}</h3>
            <div class="service-videos" data-count={service.videos.length}>
              {service.videos.map((id) => (
                <EmbedFacade
                  platform="youtube"
                  embedId={id}
                  title={service.title}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <DiscordCta />
  </section>
</Base>

{/* ヒーロー用の動画リスト。クライアント側でランダムに1本選ぶ */}
<script
  type="application/json"
  id="hero-videos"
  set:html={JSON.stringify(heroVideos).replace(/</g, "\\u003c")}
/>
<script>
  // 候補は表示時点のチャンネル動画一覧(Worker の /api/hero-videos)。
  // 取れないときだけビルド時に埋め込んだリストへフォールバック
  const dataEl = document.getElementById("hero-videos");
  const fallback: { id: string; title: string }[] = JSON.parse(
    dataEl?.textContent ?? "[]",
  );
  let videos = fallback;
  try {
    const res = await fetch("/api/hero-videos");
    if (res.ok) {
      const list = await res.json();
      if (Array.isArray(list) && list.length > 0) videos = list;
    }
  } catch {
    // フォールバックのまま
  }
  if (videos.length > 0) {
    const pick = videos[Math.floor(Math.random() * videos.length)];
    const facade = document.querySelector<HTMLElement>(".hero .facade");
    const thumb = facade?.querySelector<HTMLImageElement>(".facade-thumb");
    const button = facade?.querySelector("button");
    const metaLink = document.querySelector<HTMLAnchorElement>(
      ".hero-meta a",
    );
    if (facade && thumb && button && metaLink) {
      facade.dataset.embedSrc = `https://www.youtube-nocookie.com/embed/${pick.id}?autoplay=1`;
      facade.dataset.title = pick.title;
      thumb.src = `https://i.ytimg.com/vi/${pick.id}/hqdefault.jpg`;
      button.setAttribute("aria-label", `${pick.title} を再生`);
      metaLink.href = `https://www.youtube.com/watch?v=${pick.id}`;
      metaLink.textContent = pick.title;
    }
  }
</script>

<script>
  // 作品セクション:失敗時は静的表示のまま(リンクとラベルは機能する)

  // 最新リリース:iTunes Search API をブラウザから直接叩く(CORS 対応済み。
  // Cloudflare のエッジIPは 403 で弾かれるため Worker 経由にしない)
  async function fillLatestRelease() {
    const releaseEl = document.getElementById("latest-release");
    const artistId = releaseEl?.dataset.itunesId;
    if (!releaseEl || !artistId) return;
    const res = await fetch(
      `https://itunes.apple.com/lookup?id=${artistId}&entity=album&country=JP&sort=recent&limit=25`,
    );
    if (!res.ok) return;
    const data = await res.json();
    const latest = (data.results ?? [])
      .filter((r: any) => r.wrapperType === "collection")
      .sort((a: any, b: any) => (a.releaseDate < b.releaseDate ? 1 : -1))[0];
    if (!latest) return;

    const img = releaseEl.querySelector("img");
    const title = releaseEl.querySelector(".release-title");
    const date = releaseEl.querySelector(".release-date");
    if (img) {
      img.src = latest.artworkUrl100.replace("100x100bb", "600x600bb");
      img.hidden = false;
    }
    if (title) title.textContent = latest.collectionName;
    if (date) date.textContent = latest.releaseDate.slice(0, 10);
  }

  // 棚カード:各プラットフォームの最新ビジュアルを /api/works から埋める
  async function fillShelf() {
    const res = await fetch("/api/works");
    if (!res.ok) return;
    const data: { cards: Record<string, string | null> } = await res.json();
    for (const [key, image] of Object.entries(data.cards ?? {})) {
      if (!image) continue;
      const card = document.querySelector(`.shelf-card[data-card="${key}"]`);
      const img = card?.querySelector("img");
      if (img) {
        img.src = image;
        img.hidden = false;
      }
    }
  }

  fillLatestRelease().catch(() => {});
  fillShelf().catch(() => {});
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: start;
    margin-block-start: 2rem;
  }

  .hero-meta {
    margin-block-start: 0.75rem;
  }

  .hero-vertical {
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    letter-spacing: 0.2em;
    color: var(--moss);
    font-size: 0.85rem;
    max-height: 22rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .section-title {
    margin-block-end: 2rem;
  }

  .section-lead {
    max-width: var(--measure);
    margin-block-end: 2.5rem;
  }

  .services {
    display: grid;
    gap: 3.5rem;
  }

  .service-title {
    font-size: 1.05rem;
    margin-block-end: 1rem;
  }

  .service-videos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .service-videos {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-videos[data-count="1"] {
      grid-template-columns: minmax(0, 32rem);
    }
  }

  /* 最新リリース:ジャケット + 情報の2カラム(モバイルは縦積み) */
  .release {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 2.5rem;
    margin-block-end: 3.5rem;
  }

  @media (min-width: 640px) {
    .release {
      grid-template-columns: 16rem 1fr;
      align-items: start;
    }
  }

  .release-cover {
    display: block;
    aspect-ratio: 1;
    background: var(--haze);
    overflow: hidden;
  }

  .release-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .release-title {
    font-size: 1.35rem;
    margin-block: 0.5rem 0.25rem;
    min-height: 1em;
  }

  .release-listen {
    margin-block-start: 1.5rem;
  }

  .compilation {
    margin-block-end: 3.5rem;
  }

  @media (min-width: 640px) {
    .compilation-video {
      max-width: 32rem;
    }
  }

  /* 棚:各プラットフォームの最新ビジュアルを正方形カードで並べる */
  .shelf {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
  }

  @media (min-width: 640px) {
    .shelf {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .shelf-card {
    display: block;
    text-decoration: none;
  }

  .shelf-thumb {
    position: relative;
    display: block;
    aspect-ratio: 1;
    background: var(--haze);
    overflow: hidden;
  }

  .shelf-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shelf-blank {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    color: var(--moss);
  }

  .shelf-label {
    display: block;
    margin-block-start: 0.5rem;
  }

  .shelf-card:hover .shelf-label {
    color: var(--ink);
  }
</style>
