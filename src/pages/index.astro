---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EmbedFacade from "../components/EmbedFacade.astro";
import WorkCard from "../components/WorkCard.astro";
import WordRow from "../components/WordRow.astro";
import DiscordCta from "../components/DiscordCta.astro";
import { SITE } from "../config";

const works = (await getCollection("works")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const words = (await getCollection("words")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// ヒーロー:featured の最新 1本。なければ最新の埋め込み可能な作品
const hero =
  works.find((w) => w.data.featured && w.data.embedId) ??
  works.find((w) => w.data.embedId);

const recentWorks = works.filter((w) => w.id !== hero?.id).slice(0, 3);
const recentWords = words.slice(0, 3);
---

<Base>
  {
    hero && hero.data.embedId && hero.data.platform !== "none" && (
      <section class="hero settle-hero">
        <div class="hero-embed">
          <EmbedFacade
            platform={hero.data.platform}
            embedId={hero.data.embedId}
            title={hero.data.title}
          />
          <p class="meta hero-meta">
            <a href={`/works/${hero.id}/`}>{hero.data.title}</a>
          </p>
        </div>
        {/* 縦書きはサイト全体でここ一箇所だけ(§3.3) */}
        <p class="hero-vertical" aria-hidden="true">
          {SITE.verticalLine}
        </p>
        <p class="visually-hidden">{SITE.verticalLine}</p>
      </section>
    )
  }

  <section class="section">
    <h2 class="section-title settle">Works</h2>
    <div class="works-grid">
      {recentWorks.map((work) => <WorkCard work={work} />)}
    </div>
    <p class="more meta settle"><a href="/works/">すべての作品</a></p>
  </section>

  <section class="section">
    <h2 class="section-title settle">Words</h2>
    <ul class="words-list">
      {recentWords.map((word) => <WordRow word={word} />)}
    </ul>
    <p class="more meta settle"><a href="/words/">すべての言葉</a></p>
  </section>

  <section class="section about-excerpt settle">
    <h2 class="section-title">About</h2>
    <p>
      体が先に引っかかって、あとから言葉がついてくる。<br />
      音楽、言葉、絵、プラグイン。素材は違っても、やっていることは同じ。
    </p>
    <p class="more meta"><a href="/about/">詳しく</a></p>
  </section>

  <section class="section">
    <DiscordCta />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: start;
    margin-block-start: 2rem;
  }

  .hero-meta {
    margin-block-start: 0.75rem;
  }

  .hero-vertical {
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    letter-spacing: 0.2em;
    color: var(--moss);
    font-size: 0.85rem;
    max-height: 22rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .section-title {
    margin-block-end: 2rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 2rem;
  }

  @media (min-width: 640px) {
    .works-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .words-list {
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--haze);
  }

  .more {
    margin-block-start: 2rem;
  }

  .about-excerpt p {
    max-width: var(--measure);
  }
</style>
