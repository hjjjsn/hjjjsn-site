---
import Base from "../layouts/Base.astro";
import EmbedFacade from "../components/EmbedFacade.astro";
import DiscordCta from "../components/DiscordCta.astro";
import { SITE, LINKS, DISCORD, SERVICES, COMPILATION } from "../config";

// ヒーロー:自分のチャンネルの動画一覧をビルド時に取得し、
// 表示のたびにクライアント側でランダムに1本選ぶ。
const FEED_URL = `https://www.youtube.com/feeds/videos.xml?channel_id=${SITE.youtubeChannelId}`;

function decodeEntities(s: string): string {
  return s
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");
}

let heroVideos: { id: string; title: string }[] = [];
try {
  const res = await fetch(FEED_URL);
  if (res.ok) {
    const xml = await res.text();
    const ids = [...xml.matchAll(/<yt:videoId>([^<]+)<\/yt:videoId>/g)].map(
      (m) => m[1],
    );
    const titles = [...xml.matchAll(/<media:title>([^<]+)<\/media:title>/g)].map(
      (m) => decodeEntities(m[1]),
    );
    heroVideos = ids.map((id, i) => ({ id, title: titles[i] ?? SITE.title }));
  }
} catch {
  // フィード取得失敗時は下のフォールバックに任せる
}
if (heroVideos.length === 0) {
  heroVideos = SERVICES.flatMap((s) =>
    s.videos.map((id) => ({ id, title: s.title })),
  );
}

const hero = heroVideos[0];
---

<Base>
  <section class="hero settle-hero">
    <div class="hero-embed">
      <EmbedFacade platform="youtube" embedId={hero.id} title={hero.title} />
      <p class="meta hero-meta">
        <a
          href={`https://www.youtube.com/watch?v=${hero.id}`}
          rel="noopener"
          target="_blank">{hero.title}</a
        >
      </p>
    </div>
    {/* 縦書きはサイト全体でここ一箇所だけ(§3.3) */}
    <p class="hero-vertical" aria-hidden="true">
      {SITE.verticalLine}
    </p>
    <p class="visually-hidden">{SITE.verticalLine}</p>
  </section>

  <section class="section">
    <h2 class="section-title settle">作品</h2>
    <div class="compilation settle">
      <h3 class="service-title">{COMPILATION.label}</h3>
      <div class="compilation-video">
        <EmbedFacade
          platform="youtube"
          embedId={COMPILATION.videoId}
          title={COMPILATION.title}
        />
      </div>
    </div>
    <ul class="support-list settle">
      {
        LINKS.map((link) => (
          <li>
            <a href={link.url} rel="me noopener" target="_blank">
              <span class="support-label">{link.label}</span>
              <span class="meta support-url">
                {link.url.replace("https://", "")}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title settle">依頼</h2>
    <p class="section-lead settle">
      相談は
      <a href={DISCORD.inviteUrl} rel="noopener" target="_blank">Discord</a>
      から。
    </p>
    <div class="services">
      {
        SERVICES.map((service) => (
          <div class="service settle">
            <h3 class="service-title">{service.title}</h3>
            <div class="service-videos" data-count={service.videos.length}>
              {service.videos.map((id) => (
                <EmbedFacade
                  platform="youtube"
                  embedId={id}
                  title={service.title}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <DiscordCta />
  </section>
</Base>

{/* ヒーロー用の動画リスト。クライアント側でランダムに1本選ぶ */}
<script
  type="application/json"
  id="hero-videos"
  set:html={JSON.stringify(heroVideos).replace(/</g, "\\u003c")}
/>
<script>
  // 候補は表示時点のチャンネル動画一覧(Worker の /api/hero-videos)。
  // 取れないときだけビルド時に埋め込んだリストへフォールバック
  const dataEl = document.getElementById("hero-videos");
  const fallback: { id: string; title: string }[] = JSON.parse(
    dataEl?.textContent ?? "[]",
  );
  let videos = fallback;
  try {
    const res = await fetch("/api/hero-videos");
    if (res.ok) {
      const list = await res.json();
      if (Array.isArray(list) && list.length > 0) videos = list;
    }
  } catch {
    // フォールバックのまま
  }
  if (videos.length > 0) {
    const pick = videos[Math.floor(Math.random() * videos.length)];
    const facade = document.querySelector<HTMLElement>(".hero .facade");
    const thumb = facade?.querySelector<HTMLImageElement>(".facade-thumb");
    const button = facade?.querySelector("button");
    const metaLink = document.querySelector<HTMLAnchorElement>(
      ".hero-meta a",
    );
    if (facade && thumb && button && metaLink) {
      facade.dataset.embedSrc = `https://www.youtube-nocookie.com/embed/${pick.id}?autoplay=1`;
      facade.dataset.title = pick.title;
      thumb.src = `https://i.ytimg.com/vi/${pick.id}/hqdefault.jpg`;
      button.setAttribute("aria-label", `${pick.title} を再生`);
      metaLink.href = `https://www.youtube.com/watch?v=${pick.id}`;
      metaLink.textContent = pick.title;
    }
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: start;
    margin-block-start: 2rem;
  }

  .hero-meta {
    margin-block-start: 0.75rem;
  }

  .hero-vertical {
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    letter-spacing: 0.2em;
    color: var(--moss);
    font-size: 0.85rem;
    max-height: 22rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .section-title {
    margin-block-end: 2rem;
  }

  .section-lead {
    max-width: var(--measure);
    margin-block-end: 2.5rem;
  }

  .services {
    display: grid;
    gap: 3.5rem;
  }

  .service-title {
    font-size: 1.05rem;
    margin-block-end: 1rem;
  }

  .service-videos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .service-videos {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-videos[data-count="1"] {
      grid-template-columns: minmax(0, 32rem);
    }
  }

  .compilation {
    margin-block-end: 3.5rem;
  }

  @media (min-width: 640px) {
    .compilation-video {
      max-width: 32rem;
    }
  }

  .support-list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
    border-block-start: 1px solid var(--haze);
  }

  .support-list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-block: 1.25rem;
    border-block-end: 1px solid var(--haze);
    text-decoration: none;
  }

  .support-label {
    font-family: var(--font-serif);
    letter-spacing: 0.08em;
  }

  .support-list a:hover .support-label {
    color: var(--moss);
  }
</style>
