---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EmbedFacade from "../components/EmbedFacade.astro";
import WorkCard from "../components/WorkCard.astro";
import DiscordCta from "../components/DiscordCta.astro";
import { SITE, LINKS, DISCORD } from "../config";

const works = (await getCollection("works")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// ヒーロー:featured の最新 1本。なければ最新の埋め込み可能な作品
const hero =
  works.find((w) => w.data.featured && w.data.embedId) ??
  works.find((w) => w.data.embedId);
---

<Base>
  {
    hero && hero.data.embedId && hero.data.platform !== "none" && (
      <section class="hero settle-hero">
        <div class="hero-embed">
          <EmbedFacade
            platform={hero.data.platform}
            embedId={hero.data.embedId}
            title={hero.data.title}
          />
          <p class="meta hero-meta">
            <a href={`/works/${hero.id}/`}>{hero.data.title}</a>
          </p>
        </div>
        {/* 縦書きはサイト全体でここ一箇所だけ(§3.3) */}
        <p class="hero-vertical" aria-hidden="true">
          {SITE.verticalLine}
        </p>
        <p class="visually-hidden">{SITE.verticalLine}</p>
      </section>
    )
  }

  <section class="section">
    <h2 class="section-title settle">Works</h2>
    <p class="section-lead settle">
      頼まれてできること。ボーカルミックスと、オケ音源の制作。
      相談は <a href={DISCORD.inviteUrl} rel="noopener" target="_blank">Discord</a> から。
    </p>
    <div class="works-grid">
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title settle">Support</h2>
    <p class="section-lead settle">
      応援して欲しいこと。聴く、観る、手に取る。どれでも。
    </p>
    <ul class="support-list settle">
      {
        LINKS.map((link) => (
          <li>
            <a href={link.url} rel="me noopener" target="_blank">
              <span class="support-label">{link.label}</span>
              <span class="meta support-url">
                {link.url.replace("https://", "")}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section about-excerpt settle">
    <h2 class="section-title">About</h2>
    <p>
      体が先に引っかかって、あとから言葉がついてくる。<br />
      素材は違っても、やっていることは同じ。
    </p>
    <p class="more meta"><a href="/about/">詳しく</a></p>
  </section>

  <section class="section">
    <DiscordCta />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: start;
    margin-block-start: 2rem;
  }

  .hero-meta {
    margin-block-start: 0.75rem;
  }

  .hero-vertical {
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    letter-spacing: 0.2em;
    color: var(--moss);
    font-size: 0.85rem;
    max-height: 22rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .section-title {
    margin-block-end: 2rem;
  }

  .section-lead {
    max-width: var(--measure);
    margin-block-end: 2.5rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 2rem;
  }

  @media (min-width: 640px) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .support-list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
    border-block-start: 1px solid var(--haze);
  }

  .support-list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-block: 1.25rem;
    border-block-end: 1px solid var(--haze);
    text-decoration: none;
  }

  .support-label {
    font-family: var(--font-serif);
    letter-spacing: 0.08em;
  }

  .support-list a:hover .support-label {
    color: var(--moss);
  }

  .more {
    margin-block-start: 2rem;
  }

  .about-excerpt p {
    max-width: var(--measure);
  }
</style>
