---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import WorkCard from "../../components/WorkCard.astro";
import { DISCORD } from "../../config";

const works = (await getCollection("works")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Works" current="works">
  <h1 class="page-title settle-hero">Works</h1>
  <p class="page-lead settle-hero">
    頼まれてできること。
    相談は <a href={DISCORD.inviteUrl} rel="noopener" target="_blank">Discord</a> から。
  </p>
  <div class="works-grid">
    {works.map((work) => <WorkCard work={work} />)}
  </div>
</Base>

<style>
  .page-title {
    margin-block: 3rem 2rem;
  }

  .page-lead {
    max-width: var(--measure);
    margin-block-end: 3.5rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem 2rem;
  }

  @media (min-width: 640px) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
