---
import type { CollectionEntry } from "astro:content";

interface Props {
  word: CollectionEntry<"words">;
}

const { word } = Astro.props;
const { title, date, kind, url, description } = word.data;

const kindLabel = { book: "book", note: "note", essay: "essay" }[kind];
const href = url ?? `/words/`; // kind: essay の本文ページは Phase 2
const external = Boolean(url);
const dateLabel = date.toISOString().slice(0, 10);
---

<li class="word-row settle">
  <a
    href={href}
    class="word-link"
    rel={external ? "noopener" : undefined}
    target={external ? "_blank" : undefined}
  >
    <span class="word-title">{title}</span>
    <span class="meta">── {kindLabel} · {dateLabel}</span>
  </a>
  {description && <p class="word-description">{description}</p>}
</li>

<style>
  .word-row {
    padding-block: 1.25rem;
    border-block-end: 1px solid var(--haze);
  }

  .word-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    text-decoration: none;
  }

  .word-title {
    font-family: var(--font-serif);
    letter-spacing: 0.08em;
  }

  .word-link:hover .word-title {
    color: var(--moss);
  }

  .word-description {
    font-size: 0.85rem;
    margin-block-start: 0.35rem;
    color: var(--ink);
  }
</style>
