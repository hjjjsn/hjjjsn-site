---
import type { CollectionEntry } from "astro:content";

interface Props {
  work: CollectionEntry<"works">;
}

const { work } = Astro.props;
const { title, date, type, tags, description, platform, embedId } = work.data;

const thumbnail =
  platform === "youtube" && embedId
    ? `https://i.ytimg.com/vi/${embedId}/hqdefault.jpg`
    : null;

const dateLabel = date.toISOString().slice(0, 10);
---

<!-- カードは静的。枠や影をつけず、余白と罫線だけで区切る(§3.5) -->
<a href={`/works/${work.id}/`} class="work-card settle">
  <div class="thumb-frame">
    {
      thumbnail ? (
        <img
          src={thumbnail}
          alt=""
          loading="lazy"
          width="480"
          height="360"
          class="thumb melt-on-hover"
        />
      ) : (
        <span class="thumb-blank melt-on-hover" aria-hidden="true">
          {type}
        </span>
      )
    }
  </div>
  <h3 class="work-title">{title}</h3>
  {description && <p class="work-description">{description}</p>}
  <p class="meta">
    {dateLabel} · {type}{tags.length > 0 && ` · ${tags.join(" / ")}`}
  </p>
</a>

<style>
  .work-card {
    display: block;
    text-decoration: none;
  }

  .thumb-frame {
    aspect-ratio: 16 / 9;
    background: var(--haze);
    overflow: hidden;
    margin-block-end: 0.75rem;
  }

  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-blank {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--moss);
  }

  .work-title {
    font-size: 1.05rem;
  }

  .work-card:hover .work-title {
    color: var(--moss);
  }

  .work-description {
    font-size: 0.85rem;
    margin-block: 0.25rem 0.5rem;
  }
</style>
